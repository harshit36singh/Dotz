<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dotz" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dotz_ink</item>
        <item name="android:colorBackground">@color/dotz_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Android 12+ system splash: ink background, adaptive icon. -->
        <item name="android:windowSplashScreenBackground">@color/dotz_ink</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
